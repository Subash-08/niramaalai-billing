# Copy to .env.local. Never commit real credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/billing_dev?appName=billing_software
MONGODB_DB=billing_dev
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# Absolute private persistent folder outside the application (for local/VPS).
PRIVATE_STORAGE_ROOT=/var/lib/billing-private

# Cloudinary Cloud Storage (required for Vercel, optional for VPS/local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
